{
  "name": "hydra-club-kitchen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "e2e": "playwright test --trace off",
    "photos:import": "tsx scripts/import-photos.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "retention": "tsx scripts/retention.ts",
    "brand:assets": "tsx scripts/brand-assets.ts",
    "scripts:bundle": "node scripts/bundle-scripts.mjs"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@node-rs/argon2": "2.2.2",
    "blurhash": "2.0.5",
    "drizzle-orm": "^0.45.4",
    "gsap": "3.15.1",
    "next": "15.5.29",
    "next-auth": "5.0.0-beta.32",
    "postgres": "^4.1.0",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.25.12",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.29",
    "tailwindcss": "4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
