# Postgres 16 connection URL (scheme postgres, with user, host, port 5432 and database name).
# The app user must be allowed to CREATE EXTENSION btree_gist (trusted extension: the DB owner can).
DATABASE_URL=
# Only used by `pnpm test`. The database name must contain "test": the suite drops and recreates its schema.
TEST_DATABASE_URL=

# Auth.js session encryption key. Generate with: openssl rand -base64 33
AUTH_SECRET=
# Public origin, no trailing slash. Also the allowed Origin for admin mutations (CSRF check).
NEXT_PUBLIC_SITE_URL=https://example.com

# First-run owner account. Used only while the users table is empty (`pnpm db:seed`);
# the owner must change it at first sign-in. Min 12 characters. Remove from env after first run.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# n8n booking notifications (see n8n/README.md). Leave empty to skip notifications.
# The secret must equal HYDRA_WEBHOOK_SECRET in n8n. Generate with: openssl rand -hex 32
N8N_BOOKING_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Cloudflare Turnstile (free). Only checked when the admin setting captcha_enabled is on.
TURNSTILE_SECRET_KEY=

# Where processed photos are stored. In Coolify: a persistent volume, e.g. /app/uploads.
UPLOAD_DIR=/app/uploads

# Analytics, loaded only after the visitor consents. Leave empty to run without them.
GA4_ID=
META_PIXEL_ID=
# Meta Conversions API access token (Events Manager > Settings). Server-side Lead on bookings, ad consent only.
META_CAPI_TOKEN=
