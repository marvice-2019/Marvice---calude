# Postgres 16. The app user must be allowed to CREATE EXTENSION btree_gist
# (it is a trusted extension, so the database owner can).
DATABASE_URL=postgres://hydra:CHANGE_ME@localhost:5432/hydra
# Only used by `pnpm test`. The name must contain "test": the suite drops and recreates its schema.
TEST_DATABASE_URL=postgres://hydra:CHANGE_ME@localhost:5432/hydra_test
# Remaining variables (AUTH_SECRET, N8N_*, GA4_ID, META_*, UPLOAD_DIR, ADMIN_SEED_*) arrive with stages 2-7.
