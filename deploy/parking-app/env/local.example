# LOCAL GATE values only (throwaway, not secrets). Used with docker-compose.local.yml.
APP_ENV=staging
WEB_ORIGIN=http://localhost:13001
DEV_FAKE_PAY=1
POSTGRES_PASSWORD=local-gate-only
JWT_SECRET=local-gate-only-local-gate-only-0123456789
INTERNAL_TOKEN=local-gate-only-0123
RAZORPAY_WEBHOOK_SECRET=local-gate-webhook
OTP_PROVIDER=console
S3_ENDPOINT=http://s3:9000
S3_REGION=us-east-1
S3_BUCKET=bayline-backups
S3_PREFIX=local
S3_ACCESS_KEY_ID=localgate
S3_SECRET_ACCESS_KEY=localgatesecret
PG_MEM_LIMIT=768M
API_MEM_LIMIT=384M
WEB_MEM_LIMIT=384M
