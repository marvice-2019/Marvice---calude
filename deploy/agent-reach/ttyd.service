[Unit]
Description=Agent web terminal (ttyd + tmux) for @DOMAIN@
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=@AGENT_USER@
WorkingDirectory=@AGENT_HOME@
ExecStart=/usr/local/bin/ttyd --writable --check-origin --interface @HOST@ --port @PORT@ --max-clients 3 --ping-interval 30 -t titleFixed=@DOMAIN@ -t fontSize=15 /usr/bin/tmux new-session -A -s main
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
