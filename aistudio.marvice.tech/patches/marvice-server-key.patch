diff --git a/lib/serverKey.js b/lib/serverKey.js
new file mode 100644
index 0000000..e966557
--- /dev/null
+++ b/lib/serverKey.js
@@ -0,0 +1,16 @@
+// Marvice: optional server-side MuAPI key (MUAPI_API_KEY).
+// When it is set, the browser stores the placeholder SERVER_KEY_PLACEHOLDER
+// instead of a real key, and every /api/* request (and the server-rendered agent
+// pages) swaps it for the real key here, so the key never reaches the browser.
+// A browser that saved its own key keeps using it.
+export const SERVER_KEY_PLACEHOLDER = 'server-managed';
+
+export function hasServerKey() {
+    return Boolean(process.env.MUAPI_API_KEY);
+}
+
+export function resolveApiKey(clientKey) {
+    const serverKey = process.env.MUAPI_API_KEY;
+    if (serverKey && (!clientKey || clientKey === SERVER_KEY_PLACEHOLDER)) return serverKey;
+    return clientKey || null;
+}
