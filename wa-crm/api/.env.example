# Postgres connection. Use a normal (non-superuser) owner role in production:
# superusers bypass row-level security.
DATABASE_URL=postgres://wacrm:CHANGE_ME@postgres:5432/wacrm
PORT=3000
# 32+ random characters: openssl rand -base64 48
JWT_SECRET=
# 32 bytes, base64: openssl rand -base64 32  (encrypts WhatsApp access tokens at rest)
TOKEN_ENCRYPTION_KEY=
# From your Meta app (App settings > Basic). Used to verify webhook signatures.
META_APP_SECRET=
# Any random string; paste the same value into the Meta webhook setup.
META_WEBHOOK_VERIFY_TOKEN=
# Check the current Graph API version in Meta's changelog before go-live.
META_GRAPH_VERSION=v21.0
LOG_LEVEL=info
# Razorpay (Settings > API keys; Webhooks > secret). Billing routes return 503 until set.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Your GST state code (29 = Karnataka) and days of grace after a failed renewal.
SUPPLIER_STATE_CODE=29
BILLING_GRACE_DAYS=7
# Web app origins allowed to open the live inbox socket, comma-separated.
WEB_ORIGINS=https://app.yourdomain.com
