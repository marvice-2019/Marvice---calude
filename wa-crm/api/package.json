{
  "name": "wa-crm-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:prod": "node dist/scripts/migrate.js",
    "create-admin": "tsx scripts/create-admin.ts",
    "create-admin:prod": "node dist/scripts/create-admin.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/rate-limit": "^10.3.0",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.8",
    "jose": "^6.2.18",
    "pg": "^8.23.1",
    "socket.io": "4.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.10",
    "@types/pg": "^8.23.1",
    "socket.io-client": "4.8",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
